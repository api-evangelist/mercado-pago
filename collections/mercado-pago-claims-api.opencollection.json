{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mercado Pago REST Authentication Claims API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Claims",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get A Claim",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mercadopago.com/v1/claims/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get A Claim"
        },
        {
          "info": {
            "name": "Search Claims",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mercadopago.com/v1/claims/search"
          },
          "docs": "Search Claims"
        }
      ]
    }
  ],
  "bundled": true
}