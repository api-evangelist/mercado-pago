{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mercado Pago REST Authentication Payment Methods API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Payment Methods",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Payment Methods",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mercadopago.com/v1/payment_methods"
          },
          "docs": "List Payment Methods"
        },
        {
          "info": {
            "name": "List Identification Types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mercadopago.com/v1/identification_types"
          },
          "docs": "List Identification Types"
        }
      ]
    }
  ],
  "bundled": true
}