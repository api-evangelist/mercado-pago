{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mercado Pago REST Authentication QR API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "QR",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create A QR Order",
            "type": "http"
          },
