    "init_point": "mp:initPoint",
    "notification_url": "mp:notificationUrl",
    "auto_recurring": "mp:autoRecurring",
    "frequency": "schema:frequency",
    "frequency_type": "mp:frequencyType",
    "reason": "schema:description",
    "back_url": "mp:backUrl"
  }
